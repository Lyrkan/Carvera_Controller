#:import tr carveracontroller.__main__.tr
#:import HEADER_HEIGHT carveracontroller.ui.GcodeColorSchemePanel.HEADER_HEIGHT
#:import PANEL_BOTTOM_PADDING carveracontroller.ui.GcodeColorSchemePanel.PANEL_BOTTOM_PADDING

<GcodeColorSchemePanel>:
    orientation: 'vertical'
    size_hint: None, None
    width: dp(180)
    height: 0 if not app.show_gcode_ctl_bar else (HEADER_HEIGHT + PANEL_BOTTOM_PADDING + legend_scroll.height)
    opacity: 1 if app.show_gcode_ctl_bar else 0
    disabled: not app.show_gcode_ctl_bar or (app.selected_remote_filename == '' and app.selected_local_filename == '')
    pos_hint: {'right': 0.988, 'top': 0.90}
    padding: 0, 0, 0, dp(6)
    spacing: 0
    canvas.before:
        Color:
            rgba: 10/255, 10/255, 10/255, 0.5
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        size_hint_y: None
        height: dp(36)
        spacing: dp(6)
        padding: dp(6), dp(4)
        canvas.before:
            Color:
                rgba: 88/255, 88/255, 88/255, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: tr._('Colors')
            halign: 'left'
            valign: 'middle'
            color: 250/255, 250/255, 250/255, 1
            size_hint_x: 0.3
            text_size: self.size
        Spinner:
            id: gcode_color_scheme_spinner
            text: tr._('Move type')
            values: tr._('Move type'), tr._('Tool'), tr._('Speed')
            size_hint_x: 0.7
            on_text:
                app.root.on_gcode_color_scheme_changed(self.text)
    ScrollView:
        id: legend_scroll
        size_hint_y: None
        do_scroll_x: False
        bar_width: dp(5)
        bar_color: 0.45, 0.45, 0.45, 0.8
        bar_inactive_color: 0.35, 0.35, 0.35, 0.5
        BoxLayout:
            id: legend_box
            orientation: 'vertical'
            size_hint_x: 1
            size_hint_y: None
            spacing: dp(2)
            padding: dp(8), dp(4), dp(8), dp(2)
